    "check": "pnpm format:check && turbo run typecheck lint test"
  },
  "devDependencies": {
    "@heydovo/config": "workspace:*",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "7.0.2"
  }
}
